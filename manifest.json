{
  "manifest_version": 3,
  "name": "Edge Chat Sidebar",
  "version": "2.2.0",
  "description": "在 Microsoft Edge 侧栏中调用你配置的 LLM API，支持 DeepSeek、MiMo、多模态对话、联网搜索和本地加密历史。",
  "homepage_url": "https://github.com/HaoZhong03/EdgeChatSidebar",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "Open Sidebar",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "background": {
    "service_worker": "service_worker.js"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "sidePanel",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://api.deepseek.com/*",
    "https://api.xiaomimimo.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ]
}
