{
  "manifest_version": 3,
  "name": "Edge Chat Sidebar",
  "version": "1.0.0",
  "description": "Use LLM API from the Microsoft Edge sidebar.",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "Open Sidebar",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "background": {
    "service_worker": "service_worker.js"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://api.deepseek.com/*",
    "https://api.xiaomimimo.com/*",
    "https://api.mimo.xiaomi.com/*"
  ]
}
